# TCG Vision — Production Environment Variables

NODE_ENV=production
PORT=4000

# PostgreSQL Production Database
POSTGRES_USER=tcg_admin
POSTGRES_PASSWORD=change_this_to_strong_production_password_2026
POSTGRES_DB=tcg_vision_db
DATABASE_URL="postgresql://tcg_admin:change_this_to_strong_production_password_2026@postgres:5432/tcg_vision_db?schema=public"

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Security
JWT_SECRET=super_secret_production_jwt_key_tcg_vision_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_tcg_vision_2026
REFRESH_TOKEN_EXPIRES_IN=30d

# Public Application URLs
API_URL=https://api.tcgvision.com
WEB_URL=https://tcgvision.com
ADMIN_URL=https://admin.tcgvision.com
